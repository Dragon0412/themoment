# App
APP_NAME=此刻
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/themoment

# Redis
REDIS_URL=redis://localhost:6379/0

# OSS (Alibaba Cloud / AWS S3)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key
OSS_ACCESS_KEY_SECRET=your-secret-key
OSS_BUCKET=themoment-content
OSS_REGION=cn-hangzhou

# CDN
CDN_BASE_URL=https://cdn.themoment.app
CDN_EXPIRE_HOURS=24

# AI Pipeline
AI_IMAGE_API_URL=https://api.openai.com/v1
AI_IMAGE_API_KEY=sk-your-key
AI_AUDIO_API_URL=https://api.openai.com/v1
AI_AUDIO_API_KEY=sk-your-key

# Apple Sign In
APPLE_TEAM_ID=your-team-id
APPLE_SERVICE_ID=com.themoment.app
APPLE_KEY_ID=your-key-id
APPLE_PRIVATE_KEY_PATH=keys/AuthKey.p8

# App Store IAP Verification
APP_STORE_SHARED_SECRET=your-shared-secret
APP_STORE_VERIFY_RECEIPT_URL=https://buy.itunes.apple.com/verifyReceipt
APP_STORE_VERIFY_RECEIPT_SANDBOX_URL=https://sandbox.itunes.apple.com/verifyReceipt

# CMS Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=change-me

# CDN scheduled cleanup (cron)
CONTENT_EXPIRE_HOURS=24
CLEANUP_INTERVAL_MINUTES=30
